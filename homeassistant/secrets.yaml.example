# Contoh file secrets.yaml untuk Home Assistant
# Salin file ini menjadi secrets.yaml lalu isi dengan kredensial asli Anda
telegram_bot_token: "<YOUR_TELEGRAM_BOT_TOKEN>"
telegram_chat_id_semua: "<YOUR_TELEGRAM_GROUP_ALL_ID>"
telegram_chat_id_jogja: "<YOUR_TELEGRAM_GROUP_JOGJA_ID>"
telegram_chat_id_senayan: "<YOUR_TELEGRAM_GROUP_SENAYAN_ID>"
